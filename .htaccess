# Hostinger cPanel / Apache Phusion Passenger Configuration
<IfModule mod_rewrite.c>
    RewriteEngine On
    # Do not rewrite API requests or existing files/directories
    RewriteCond %{REQUEST_URI} ^/api/ [NC]
    RewriteRule ^ - [L]
    
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # All other routes handled by Node.js server.js
</IfModule>
